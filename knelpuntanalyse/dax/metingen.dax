// DAX metingen voor de meetlog (versie v1)
// Tabellen: Mail, Doorlooptijd, MailPerZaak, KIM, UrenPerDag (Werkdagen alleen via de queries)
// K10 komt uit de handmatige tijdsmeting en staat niet in DAX.

// ---- op tabel Doorlooptijd ----

K1 Inkomende mails = COUNTROWS('Doorlooptijd')

K6 Mediane doorlooptijd (uren) = MEDIAN('Doorlooptijd'[DoorlooptijdUren])

K7 Binnen 120 uur =
VAR Beantwoord =
    CALCULATE(COUNTROWS('Doorlooptijd'), 'Doorlooptijd'[Status] = "Beantwoord")
VAR OpTijd =
    CALCULATE(
        COUNTROWS('Doorlooptijd'),
        'Doorlooptijd'[Status] = "Beantwoord",
        'Doorlooptijd'[DoorlooptijdUren] <= 120
    )
RETURN
    DIVIDE(OpTijd, Beantwoord)

K8 Open ouder dan 7 dagen =
CALCULATE(
    COUNTROWS('Doorlooptijd'),
    'Doorlooptijd'[Status] = "Open",
    'Doorlooptijd'[LeeftijdDagen] > 7
)

// ---- op tabel Doorlooptijd, optioneel in werkdagen (zonder weekenden en feestdagen) ----

K6w Mediane doorlooptijd (werkdagen) = MEDIAN('Doorlooptijd'[DoorlooptijdWerkdagen])

K7w Binnen 5 werkdagen =
VAR Beantwoord =
    CALCULATE(COUNTROWS('Doorlooptijd'), 'Doorlooptijd'[Status] = "Beantwoord")
VAR OpTijd =
    CALCULATE(
        COUNTROWS('Doorlooptijd'),
        'Doorlooptijd'[Status] = "Beantwoord",
        'Doorlooptijd'[DoorlooptijdWerkdagen] <= 5
    )
RETURN
    DIVIDE(OpTijd, Beantwoord)

K8w Open ouder dan 5 werkdagen =
CALCULATE(
    COUNTROWS('Doorlooptijd'),
    'Doorlooptijd'[Status] = "Open",
    'Doorlooptijd'[LeeftijdWerkdagen] > 5
)

// ---- op tabel Mail ----

K2 Aandeel standaardmail =
DIVIDE(
    CALCULATE(COUNTROWS(Mail), Mail[Soort] = "Standaardmail", Mail[Richting] = "Inkomend"),
    CALCULATE(COUNTROWS(Mail), Mail[Richting] = "Inkomend")
)

// Onbekend is een restcategorie en telt niet mee als herhaling
K3 Hoogste herhaalfactor =
MAXX(
    FILTER(VALUES(Mail[Categorie]), Mail[Categorie] <> "Onbekend"),
    DIVIDE(
        CALCULATE(COUNTROWS(Mail)),
        CALCULATE(DISTINCTCOUNT(Mail[OnderwerpSchoon]))
    )
)

K4 Aandeel statusvragen =
DIVIDE(
    CALCULATE(
        COUNTROWS(Mail),
        Mail[Categorie] = "Statusvraag",
        Mail[Richting] = "Inkomend",
        Mail[Intern] = FALSE()
    ),
    CALCULATE(COUNTROWS(Mail), Mail[Richting] = "Inkomend", Mail[Intern] = FALSE())
)

K12 Aandeel onbekend =
DIVIDE(CALCULATE(COUNTROWS(Mail), Mail[Categorie] = "Onbekend"), COUNTROWS(Mail))

// ---- op tabel MailPerZaak ----

K5 Mediane langste stilte (dagen) = MEDIAN(MailPerZaak[LangsteStilteDagen])

// ---- op tabel KIM ----

K9 Zaken over termijn =
DIVIDE(
    CALCULATE(COUNTROWS(KIM), KIM[OverTermijn] = TRUE()),
    CALCULATE(COUNTROWS(KIM), KIM[OpenOpPeildatum] = TRUE())
)

// ---- op tabel UrenPerDag ----

K11 Uren met mail per dag = MEDIAN(UrenPerDag[UrenMetMail])
